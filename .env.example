# =============================================================================
# PSIAPP — VARIÁVEIS DE AMBIENTE (.env.local)
# =============================================================================
# Copie este arquivo para ".env.local" na raiz do projeto e preencha com suas credenciais.

# 1. BANCO DE DADOS & AUTENTICAÇÃO (SUPABASE)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# 2. STORAGE (BUCKETS DO SUPABASE)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://seu-projeto.supabase.co/storage/v1/object/public

# 3. DISPARO DE E-MAILS & CONVITES (RESEND / SMTP)
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_123456789
EMAIL_FROM="PsiApp <contato@seudominio.com.br>"

# 4. DISPARO DE WHATSAPP (TWILIO / Z-API / EVOLUTION)
# Exemplo Z-API (https://z-api.io) ou Twilio
WHATSAPP_API_URL=https://api.z-api.io/instances/SUA_INSTANCIA/token/SEU_TOKEN
WHATSAPP_CLIENT_TOKEN=seu-token-aqui

# 5. GATEWAY DE PAGAMENTO (ASAAS / STRIPE / PAGAR.ME)
# Exemplo Asaas Sandbox / Produção (https://asaas.com)
ASAAS_API_KEY=$aact_YTU5YTE0M2M6N2I4...
ASAAS_ENVIRONMENT=sandbox # ou production

# 6. CONFIGURAÇÃO DE AMBIENTE
NEXT_PUBLIC_APP_URL=http://localhost:3000
